# PostgreSQL (Neon) connection string
DATABASE_URL=postgresql://username:password@host.neon.tech/neondb?sslmode=require&channel_binding=require

# Flask/JWT secrets (use random long values in production)
SECRET_KEY=change_me_secret
JWT_SECRET_KEY=change_me_jwt_secret

# Google sign-in backend validation
GOOGLE_WEB_CLIENT_ID=

# Optional
# CORS_ORIGINS=*
