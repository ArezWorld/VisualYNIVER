<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/search_suggestion_pressed_surface" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/search_suggestion_pressed_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/search_suggestion_surface" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/search_suggestion_regular_stroke" />
        </shape>
    </item>
</selector>
